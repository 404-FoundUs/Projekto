### GET request to example server
GET https://examples.http-client.intellij.net/get
    ?generated-in=IntelliJ IDEA

### Create User (Signup)
POST http://localhost:8080/api/v1/user/signup
Content-Type: application/json

{
  "username": "Shehans",
  "email": "shehans@gmail.com",
  "password": "password123",
  "firstName": "Shehans",
  "lastName": "Kaushalyas",
  "isActive": true
}

### Signin User
POST http://localhost:8080/api/v1/user/signin
Content-Type: application/json

{
  "email": "shehan@gmail.com",
  "password": "password123"
}

### Create Workspace
POST http://localhost:8080/api/v1/workspaces?ownerId=feefbcfd-871f-482a-b345-861ba3a6dd27
Content-Type: application/json

{
  "name": "Project Projekto",
  "description": "Workspace for Project 404NOTFOUNDUS",
  "visibility": "PUBLIC"
}

### Get User Workspaces
GET http://localhost:8080/api/v1/workspaces/user/feefbcfd-871f-482a-b345-861ba3a6dd27
Content-Type: application/json

### Get Workspace by ID
GET http://localhost:8080/api/v1/workspaces/58e0c9ca-0182-42c9-897d-62f7d97cad95
Content-Type: application/json

### Update Workspace
PUT http://localhost:8080/api/v1/workspaces/99778641-ca38-4b9b-ae2e-260b3eb8496b?ownerId=7e394119-8c39-4fa0-a3e5-2385afc83fe1
Content-Type: application/json

{
  "name": "Project Alpha Updated",
  "description": "Updated description",
  "visibility": "PRIVATE"
}

### Add Member to Workspace (Return Updated Workspace)
POST http://localhost:8080/api/v1/workspaces/58e0c9ca-0182-42c9-897d-62f7d97cad95/members/c9c98e6a-1495-42a2-a0f7-2af9540edffd
Content-Type: application/json



### Remove Member from Workspace
DELETE http://localhost:8080/api/v1/workspaces/58e0c9ca-0182-42c9-897d-62f7d97cad95/members/c9c98e6a-1495-42a2-a0f7-2af9540edffd
Content-Type: application/json

### Delete Workspace
DELETE http://localhost:8080/api/v1/workspaces/58e0c9ca-0182-42c9-897d-62f7d97cad95
Content-Type: application/json


### Create Board
POST http://localhost:8080/api/v1/boards
Content-Type: application/json

{
  "name": "Project Planning Board",
  "description": "Board for sprint planning",
  "visibility": "PUBLIC",
  "workspaceId": "51037f50-3a98-4012-90ba-1eede7e4a002",
  "createdBy": "feefbcfd-871f-482a-b345-861ba3a6dd27"
}

### Get Boards by Workspace
GET http://localhost:8080/api/v1/boards/workspace/f4b909ce-f919-4263-9bb9-19d04ac561ce


### Get Board by ID
GET http://localhost:8080/api/v1/boards/645c4497-0dd3-4bf2-a5d1-4a50dbf6f3ef

### Update Board
PUT http://localhost:8080/api/v1/boards/645c4497-0dd3-4bf2-a5d1-4a50dbf6f3ef
Content-Type: application/json

{
  "name": "Updated Board Name",
  "description": "Updated description",
  "visibility": "PRIVATE",
  "workspaceId": "11111111-1111-1111-1111-111111111111",
  "createdBy": "22222222-2222-2222-2222-222222222222"
}

### Delete Board
DELETE http://localhost:8080/api/v1/boards/645c4497-0dd3-4bf2-a5d1-4a50dbf6f3ef

### Create List API
POST http://localhost:8080/api/v1/lists
Content-Type: application/json

{
  "title": "To Do 2",
  "boardId": "00f98f31-dca9-4c82-9de8-6abc9aa77c47"
}

### Get Lists by Board API
GET http://localhost:8080/api/v1/lists/board/00f98f31-dca9-4c82-9de8-6abc9aa77c47
Accept: application/json

### Update List API
PUT http://localhost:8080/api/v1/lists/7ac918ad-468c-427d-adad-8c48b3d8c185
Content-Type: application/json

{
  "title": "In Progress",
  "boardId": "00f98f31-dca9-4c82-9de8-6abc9aa77c47"
}


### Delete List API
DELETE http://localhost:8080/api/v1/lists/7ac918ad-468c-427d-adad-8c48b3d8c185

### Reorder Lists API
PATCH http://localhost:8080/api/v1/lists/board/00f98f31-dca9-4c82-9de8-6abc9aa77c47/reorder
Content-Type: application/json

{
  "orderedListIds": [
    "ff8bf895-028b-4ecb-b18c-188c319f2880",
    "95d95f1d-e0d8-42ab-8a62-4b8f6643879b",
    "febe613c-3b00-47df-8422-d84dbd2b4f47"
  ]
}
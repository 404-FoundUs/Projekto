### GET request to example server
GET https://examples.http-client.intellij.net/get
    ?generated-in=IntelliJ IDEA

### Create User (Signup)
POST http://localhost:8080/api/v1/user/signup
Content-Type: application/json

{
  "username": "Shehan",
  "email": "shehan@gmail.com",
  "password": "password123",
  "firstName": "Shehans",
  "lastName": "Kaushalyas",
  "isActive": true
}

### Signin User
POST http://localhost:8080/api/v1/user/signin
Content-Type: application/json

{
  "email": "shehan@gmail.com",
  "password": "password123"
}

### Create Workspace
POST http://localhost:8080/api/v1/workspaces
Content-Type: application/json

{
  "name": "Project Hello",
  "description": "Workspace for Project Java",
  "visibility": "PUBLIC"
}

### Get User Workspaces
GET http://localhost:8080/api/v1/workspaces/65ef429c-1697-4403-bbb5-f698456b2879
Content-Type: application/json

### Get Workspace by ID
GET http://localhost:8080/api/v1/workspaces/58e0c9ca-0182-42c9-897d-62f7d97cad95
Content-Type: application/json

### Update Workspace
PUT http://localhost:8080/api/v1/workspaces/99778641-ca38-4b9b-ae2e-260b3eb8496b?ownerId=7e394119-8c39-4fa0-a3e5-2385afc83fe1
Content-Type: application/json

{
  "name": "Project Alpha Updated",
  "description": "Updated description",
  "visibility": "PRIVATE"
}

### Add Member to Workspace (Return Updated Workspace)
POST http://localhost:8080/api/v1/workspaces/58e0c9ca-0182-42c9-897d-62f7d97cad95/members/c9c98e6a-1495-42a2-a0f7-2af9540edffd
Content-Type: application/json



### Remove Member from Workspace
DELETE http://localhost:8080/api/v1/workspaces/58e0c9ca-0182-42c9-897d-62f7d97cad95/members/c9c98e6a-1495-42a2-a0f7-2af9540edffd
Content-Type: application/json

### Delete Workspace
DELETE http://localhost:8080/api/v1/workspaces/58e0c9ca-0182-42c9-897d-62f7d97cad95
Content-Type: application/json


### Create Board
POST http://localhost:8080/api/v1/boards
Content-Type: application/json

{
  "name": "Project Planning Board",
  "description": "Board for sprint planning",
  "visibility": "PUBLIC",
  "workspaceId": "5d2871fe-5984-4110-bd40-a337db158897",
  "createdBy": "1eb8083f-cda4-4c7b-9a11-74bdb4389765"
}

### Get Boards by Workspace
GET http://localhost:8080/api/v1/boards/workspace/5d2871fe-5984-4110-bd40-a337db158897


### Get Board by ID
GET http://localhost:8080/api/v1/boards/2f9081a2-f596-4698-b735-e745bcda206a

### Update Board
PUT http://localhost:8080/api/v1/boards/b5ddb9bf-e8c6-430b-bfba-3152fe6ba54b
Content-Type: application/json

{
  "name": "Updated Board Name",
  "description": "Updated description",
  "visibility": "PRIVATE",
  "workspaceId": "11111111-1111-1111-1111-111111111111",
  "createdBy": "22222222-2222-2222-2222-222222222222"
}

### Delete Board
DELETE http://localhost:8080/api/v1/boards/645c4497-0dd3-4bf2-a5d1-4a50dbf6f3ef

### Create List API
POST http://localhost:8080/api/v1/lists
Content-Type: application/json

{
  "title": "To Do 2",
  "boardId": "00f98f31-dca9-4c82-9de8-6abc9aa77c47"
}

### Get Lists by Board API
GET http://localhost:8080/api/v1/lists/board/00f98f31-dca9-4c82-9de8-6abc9aa77c47
Accept: application/json

### Update List API
PUT http://localhost:8080/api/v1/lists/7ac918ad-468c-427d-adad-8c48b3d8c185
Content-Type: application/json

{
  "title": "In Progress",
  "boardId": "00f98f31-dca9-4c82-9de8-6abc9aa77c47"
}


### Delete List API
DELETE http://localhost:8080/api/v1/lists/7ac918ad-468c-427d-adad-8c48b3d8c185

### Reorder Lists API
PATCH http://localhost:8080/api/v1/lists/board/00f98f31-dca9-4c82-9de8-6abc9aa77c47/reorder
Content-Type: application/json

{
  "orderedListIds": [
    "ff8bf895-028b-4ecb-b18c-188c319f2880",
    "95d95f1d-e0d8-42ab-8a62-4b8f6643879b",
    "febe613c-3b00-47df-8422-d84dbd2b4f47"
  ]
}

### Create Card
POST http://localhost:8080/api/v1/cards
Content-Type: application/json

{
  "title": "Test Card 6",
  "description": "This is a test card 56",
  "dueDate": "2026-02-05T12:00:00",
  "priority": "HIGH",
  "listId": "ff8bf895-028b-4ecb-b18c-188c319f2880"
}

### Get Cards by List
GET http://localhost:8080/api/v1/cards/list/ff8bf895-028b-4ecb-b18c-188c319f2880

### Get Card by ID
GET http://localhost:8080/api/v1/cards/64d69564-c296-4830-948c-15f8e47d08aa

### Update Card
PUT http://localhost:8080/api/v1/cards/64d69564-c296-4830-948c-15f8e47d08aa
Content-Type: application/json

{
  "title": "Updated Card Title",
  "description": "Updated description",
  "dueDate": "2026-02-10T12:00:00",
  "priority": "MEDIUM",
  "listId": "febe613c-3b00-47df-8422-d84dbd2b4f47"
}

### Delete Card
DELETE http://localhost:8080/api/v1/cards/64d69564-c296-4830-948c-15f8e47d08aa

### Move Card
PATCH http://localhost:8080/api/v1/cards/1ecba932-627c-4545-bbc7-fddfcb023ef9/move
Content-Type: application/json

{
  "targetListId": "95d95f1d-e0d8-42ab-8a62-4b8f6643879b",
  "newPosition": 0
}


### Reorder Cards
PATCH http://localhost:8080/api/v1/cards/list/95d95f1d-e0d8-42ab-8a62-4b8f6643879b/reorder
Content-Type: application/json

{
  "orderedCardIds": [
    "16e7dc5d-4b28-4f21-9f9b-adc9d2967915",
    "44e1d32d-4464-4b0c-a736-d6a95a9a478b",
    "e0ae635a-56d7-42b7-82e9-07f44030f88d"
  ]
}

### Create Label
POST http://localhost:8080/api/v1/labels
Content-Type: application/json

{
  "name": "Bug",
  "color": "#FF0000",
  "boardId": "00f98f31-dca9-4c82-9de8-6abc9aa77c47"
}

### Get Labels by Board
GET http://localhost:8080/api/v1/labels/board/00f98f31-dca9-4c82-9de8-6abc9aa77c47

### Assign Label to Card
POST http://localhost:8080/api/v1/labels/assign
Content-Type: application/json

{
  "cardId": "c3854912-0b81-41ae-a4fb-ba113370692c",
  "labelId": "95ffecd2-771c-49b9-a20b-d9aeb2eac539"
}

### Remove Label from Card
POST http://localhost:8080/api/v1/labels/remove
Content-Type: application/json

{
  "cardId": "c3854912-0b81-41ae-a4fb-ba113370692c",
  "labelId": "95ffecd2-771c-49b9-a20b-d9aeb2eac539"
}